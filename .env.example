# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_RESULT_LIMIT=5
TELEGRAM_MAX_CONCURRENT_SEARCHES=1

# WatchFacts
WATCHFACTS_URL=https://watchfacts.com/simon-match-making

# Runtime
HEADLESS=true
ENABLE_CRAWL4AI=true
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_MAX_CONCURRENT_SEARCHES=1
SEARCH_RETRIEVAL_CONCURRENCY=1
WATCHFACTS_HTTP_CLIENT_ENABLED=true
WATCHFACTS_FORM_CACHE_TTL_SECONDS=900
WATCHFACTS_HTTP_CONNECT_TIMEOUT_SECONDS=10
WATCHFACTS_HTTP_POOL_TIMEOUT_SECONDS=10
WATCHFACTS_HTTP_KEEPALIVE_EXPIRY_SECONDS=60
WATCHFACTS_HTTP_READ_TIMEOUT_SECONDS=30
WATCHFACTS_HTTP_SEARCH_READ_TIMEOUT_SECONDS=120
WATCHFACTS_HTTP_FAILURE_COOLDOWN_SECONDS=60
WATCHFACTS_HTTP_WARMUP_ON_HEALTH=true
# Example: https://watchfacts.onio.cc/results
RESULT_PAGE_PUBLIC_BASE_URL=
RESULT_PAGE_TTL_SECONDS=86400
RESULT_PAGE_MAX_RESULTS=200
RESULT_PAGE_STORAGE_DIR=data/result_pages

# OpenAI controlled intelligence
HYBRID_AI_MODE=off
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=12
OPENAI_MAX_REFINES=3

# OpenWA chat draft handoff
ENABLE_OPENWA_CHAT_HANDOFF=false
# Use http://openwa-api:2785 when deploying with docker-compose.openwa.yml.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_DASHBOARD_URL=
OPENWA_CHAT_DRAFT_ENDPOINT=/api/chats/drafts
OPENWA_DOCKER_NETWORK=openwa-network
