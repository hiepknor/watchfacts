# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_RESULT_LIMIT=5

# WatchFacts
WATCHFACTS_URL=https://watchfacts.com/simon-match-making

# Runtime
HEADLESS=true
ENABLE_CRAWL4AI=true

# Local LLM experiment
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://llama-cpp:8080
LOCAL_LLM_MODEL=gemma-4-E2B-it-Q8_0.gguf
LOCAL_LLM_TIMEOUT_SECONDS=8
LOCAL_LLM_MAX_REFINES=3
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CPP_PORT=8080
LLAMA_CPP_MODELS_DIR=./models
LLAMA_CPP_MODEL_FILE=gemma-4-E2B-it-Q8_0.gguf
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_PREDICT=256
