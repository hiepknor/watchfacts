watchfacts.onio.cc {
    @watchfacts_results path /results/*

    handle /results/health {
        respond '{"status":"ok","service":"watchfacts-result-pages"}' 200 {
            content_type application/json
            flush_interval -1
        }
    }

    # Caddy on this host does not include built-in rate limiting.
    # Keep app-level throttling in app/mcp_server.py:
    # - 60 requests / 60s / IP
    # - 120s block window
    #
    # If a future Caddy build includes the rate_limit module, wrap the
    # result proxy with an additional rate_limit block here.

    log @watchfacts_results {
        output stdout
        format json {
            time_format "iso8601"
        }
    }

    # Reverse-proxy only the generated result pages.
    # MCP API (/mcp) should remain internal and must not be exposed publicly.
    handle @watchfacts_results {
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Request-ID {http.request.id}
        }
    }
    }

    # Optional explicit /mcp block in case someone tries to access it publicly.
    handle /mcp* {
        respond "Not Found" 404
    }

    # All other paths return 404.
    handle {
        respond "Not Found" 404
    }

    # Security headers for result pages.
    header {
        X-Request-ID {http.request.id}
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}
