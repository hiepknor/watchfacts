watchfacts.onio.cc {
    @watchfacts_results path /results/*

    log @watchfacts_results {
        output file /var/log/caddy/watchfacts-results.log {
            roll_size 20MB
            roll_keep 7
            roll_keep_for 168h
        }
        format json {
            time_format "iso8601"
        }
    }

    # Reverse-proxy only the generated result pages.
    # MCP API (/mcp) should remain internal and must not be exposed publicly.
    handle @watchfacts_results {
        reverse_proxy 127.0.0.1:8765
    }

    # Optional explicit /mcp block in case someone tries to access it publicly.
    handle /mcp* {
        respond "Not Found" 404
    }

    # All other paths return 404.
    handle {
        respond "Not Found" 404
    }

    # Security headers for result pages.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}
